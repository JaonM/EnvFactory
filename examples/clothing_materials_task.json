    {"id": "task_success", "type": "rule-based", "scope": "terminal", "condition": "summary_ready == true and identified_materials contains at least one material and summary covers '材质特点' and '洗护注意事项'", "reward": 1.0, "penalty": 0.0, "once": true, "rubric": "成功整理材质与洗护", "weight": 0.5},
    {"id": "trajectory_quality", "type": "model-based", "scope": "trajectory", "criteria": ["是否在缺少衣物信息时先澄清再继续", "是否避免重复或过多追问", "整理内容是否覆盖材质特点与洗护注意事项"], "score_range": [0, 1], "rubric": "澄清与整理质量", "weight": 0.3, "reward": 0.0, "penalty": 0.0, "once": false}
