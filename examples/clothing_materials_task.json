{
  "task": "帮我看看这几件衣服的材质，整理一下不同材质的特点和洗护注意事项。",
  "task_type": "Event",
  "complexity": "standard",
  "environment": [
    {
      "type": "user_profile",
      "field": "interest",
      "description": "用户兴趣",
      "value": "服装"
    },
    {
      "type": "task_info",
      "field": "goal",
      "description": "任务目标",
      "value": "查看几件衣服的材质，并整理不同材质的特点和洗护注意事项"
    },
    {
      "type": "task_info",
      "field": "needs_clarification",
      "description": "任务是否需要澄清",
      "value": true
    },
    {
      "type": "state",
      "field": "status",
      "description": "当前任务状态",
      "value": "waiting_for_clothing_info"
    },
    {
      "type": "state",
      "field": "summary_ready",
      "description": "材质特点与洗护注意事项整理是否完成",
      "value": false
    },
    {
      "type": "hidden_state",
      "field": "required_material_categories",
      "description": "需要覆盖的材质类别",
      "value": [
        "棉",
        "麻",
        "丝",
        "羊毛",
        "聚酯纤维",
        "锦纶",
        "氨纶",
        "粘胶纤维"
      ]
    },
    {
      "type": "hidden_state",
      "field": "required_summary_sections",
      "description": "要求的整理内容板块",
      "value": [
        "材质特点",
        "洗护注意事项"
      ]
    },
    {
      "type": "action",
      "field": "request_clothing_info",
      "description": "请求用户提供衣物图片、标签或衣物列表",
      "value": "request_clothing_info"
    },
    {
      "type": "action",
      "field": "record_clothing_items",
      "description": "记录用户提供的衣物信息",
      "value": "record_clothing_items"
    },
    {
      "type": "action",
      "field": "identify_material",
      "description": "根据衣物标签或描述识别材质",
      "value": "identify_material"
    },
    {
      "type": "action",
      "field": "summarize_material_care",
      "description": "整理不同材质的特点和洗护注意事项",
      "value": "summarize_material_care"
    },
    {
      "type": "termination",
      "field": "success",
      "description": "成功条件",
      "value": [
        "summary_ready == true",
        "identified_materials contains at least one material",
        "summary covers '材质特点' and '洗护注意事项'"
      ]
    },
    {
      "type": "termination",
      "field": "failure",
      "description": "失败条件",
      "value": [
        "summary_ready == false after final response"
      ]
    }
  ],
  "metrics": [
    {
      "id": "safe_clarification",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type == 'request_clothing_info' and safety_violation == false",
      "reward": 0.1,
      "penalty": 0.0,
      "once": false,
      "rubric": "安全请求衣物信息",
      "weight": 0.15
    },
    {
      "id": "record_items_progress",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type == 'record_clothing_items' and provided_clothing_items is non-empty",
      "reward": 0.2,
      "penalty": 0.0,
      "once": false,
      "rubric": "记录衣物信息推进任务",
      "weight": 0.2
    },
    {
      "id": "identify_material_progress",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type == 'identify_material' and identified_materials is non-empty",
      "reward": 0.2,
      "penalty": 0.0,
      "once": false,
      "rubric": "识别材质推进整理",
      "weight": 0.2
    },
    {
      "id": "task_success",
      "type": "rule-based",
      "scope": "terminal",
      "condition": "summary_ready == true and identified_materials contains at least one material and summary covers '材质特点' and '洗护注意事项'",
      "reward": 1.0,
      "penalty": 0.0,
      "once": true,
      "rubric": "成功整理材质与洗护",
      "weight": 0.5
    },
    {
      "id": "trajectory_quality",
      "type": "model-based",
      "scope": "trajectory",
      "criteria": [
        "是否在缺少衣物信息时先澄清再继续",
        "是否避免重复或过多追问",
        "整理内容是否覆盖材质特点与洗护注意事项"
      ],
      "score_range": [
        0,
        1
      ],
      "rubric": "澄清与整理质量",
      "weight": 0.3,
      "reward": 0.0,
      "penalty": 0.0,
      "once": false
    }
  ],
  "constraints": {
    "schema_version": "1.0",
    "authority": "env_factory_outer_workflow",
    "mutable_by_code_agent": false,
    "obligations": [
