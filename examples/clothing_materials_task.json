        "kind": "platform",
        "required": true
      },
      {
        "id": "platform.tool_schema",
        "kind": "platform",
        "required": true
      },
      {
        "id": "platform.hidden_truth_isolation",
        "kind": "platform",
        "required": true
      },
      {
        "id": "platform.user_simulator",
        "kind": "platform",
        "required": true
      },
      {
        "id": "platform.reward_interface",
        "kind": "platform",
        "required": true
      },
      {
        "id": "task_action.request_clothing_info",
        "kind": "task_action",
        "required": true
      },
      {
        "id": "task_action.record_clothing_items",
        "kind": "task_action",
        "required": true
      },
      {
        "id": "task_action.identify_material",
        "kind": "task_action",
        "required": true
      },
      {
        "id": "task_action.summarize_material_care",
        "kind": "task_action",
        "required": true
      },
      {
        "id": "capability.external_model_boundary",
        "kind": "capability",
        "required": true
      },
      {
        "id": "evaluation.reward_and_termination",
        "kind": "evaluation",
        "required": true
      }
    ],
    "source": {
      "task_environment": true,
      "task_metrics": true,
      "intent_constraints": [],
      "requirements": {
