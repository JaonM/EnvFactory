{
  "task": "想找个建筑师聊聊，能帮忙对接一下吗？",
  "task_type": "Event",
  "complexity": "standard",
  "environment": [
    {
      "type": "user_profile",
      "field": "clarification_preference",
      "description": "用户在当前请求中需要先澄清具体需求，偏好通过追问确认对接对象类型",
      "value": "needs_clarification_before_referral"
    },
    {
      "type": "user_profile",
      "field": "contact_preference",
      "description": "用户希望获得可联系的建筑师对接结果",
      "value": "architect_contact_referral"
    },
    {
      "type": "task_info",
      "field": "goal",
      "description": "任务目标",
      "value": "为用户对接一位可交流的建筑师"
    },
    {
      "type": "task_info",
      "field": "domain",
      "description": "任务领域",
      "value": "professional_contact_referral"
    },
    {
      "type": "task_info",
      "field": "required_clarification",
      "description": "执行前必须澄清的关键信息",
      "value": [
        "所需建筑师类型或专业方向",
        "沟通目的",
        "期望对接方式"
      ]
    },
    {
      "type": "task_info",
      "field": "constraints",
      "description": "任务约束",
      "value": [
        "不得臆造建筑师姓名或联系方式",
        "不得在未澄清前直接完成对接",
        "只能基于可用资源进行匹配",
        "需要确认用户具体需求",
        "对接结果必须可验证"
      ]
    },
    {
      "type": "state",
      "field": "status",
      "description": "当前任务状态",
      "value": "awaiting_clarification"
    },
    {
      "type": "state",
      "field": "clarification_rounds",
      "description": "已完成的澄清轮次",
      "value": 0
    },
    {
      "type": "hidden_state",
      "field": "available_architect_pool",
      "description": "环境内部可用建筑师资源池",
      "value": [
        {
          "id": "arch_001",
          "specialty": "residential_design",
          "availability": "available"
        },
        {
          "id": "arch_002",
          "specialty": "commercial_design",
          "availability": "available"
        },
        {
          "id": "arch_003",
          "specialty": "urban_planning",
          "availability": "unavailable"
        }
      ]
    },
    {
      "type": "hidden_state",
      "field": "clarification_requirements",
      "description": "环境内部判定澄清是否充分的条件",
      "value": {
        "needs_specialty": true,
        "needs_purpose": true,
        "needs_contact_method": true
      }
    },
    {
      "type": "hidden_state",
      "field": "referral_success_rule",
      "description": "环境内部对接成功判定规则",
      "value": {
        "must_match_available_architect": true,
        "must_confirm_user_acceptance": true
      }
    },
    {
      "type": "action",
      "field": "ask_clarification",
      "description": "向用户询问缺失的对接需求信息",
      "value": "ask_clarification"
    },
    {
      "type": "action",
      "field": "search_architect",
      "description": "根据澄清后的条件检索可用建筑师",
      "value": "search_architect"
    },
    {
      "type": "action",
      "field": "propose_referral",
      "description": "向用户提出建筑师对接建议",
      "value": "propose_referral"
    },
    {
      "type": "action",
      "field": "confirm_referral",
      "description": "确认并完成建筑师对接",
      "value": "confirm_referral"
    },
    {
      "type": "transition_rule",
      "field": "ask_clarification_rule",
      "description": "询问澄清后状态变化",
      "value": {
        "when": "ask_clarification is called",
        "effect": "clarification_rounds increases by 1; status becomes clarifying"
      }
    },
    {
      "type": "transition_rule",
      "field": "search_architect_rule",
      "description": "检索建筑师后的状态变化",
      "value": {
        "when": "search_architect is called with sufficient clarification",
        "effect": "status becomes matching; hidden_state.available_architect_pool is filtered"
      }
    },
    {
      "type": "transition_rule",
      "field": "propose_referral_rule",
      "description": "提出对接建议后的状态变化",
      "value": {
        "when": "propose_referral is called after matching",
        "effect": "status becomes awaiting_user_acceptance; matched_architect is set"
      }
    },
    {
      "type": "transition_rule",
      "field": "confirm_referral_rule",
      "description": "确认对接后的状态变化",
      "value": {
        "when": "confirm_referral is called after user acceptance",
        "effect": "status becomes completed"
      }
    },
    {
      "type": "termination",
      "field": "success",
      "description": "成功条件",
      "value": [
        "status == completed",
        "matched_architect is non-empty",
        "user accepted referral"
      ]
    },
    {
      "type": "termination",
      "field": "failure",
      "description": "失败条件",
      "value": [
        "status == failed",
        "clarification_rounds > 5 without sufficient clarification",
        "no available architect matches clarified requirements"
      ]
    }
  ],
  "metrics": [
    {
      "id": "safe_clarification_control",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type == 'ask_clarification' and clarification_rounds <= 5 and question_count <= 3",
      "reward": 0.1,
      "penalty": 0.0,
      "once": false,
      "rubric": "澄清追问安全且不过量",
      "weight": 0.15
    },
    {
      "id": "unsafe_referral_without_clarification",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type in ['search_architect','propose_referral','confirm_referral'] and clarification_rounds == 0",
      "reward": 0.0,
      "penalty": -1.0,
      "once": false,
      "rubric": "未澄清即推进对接",
      "weight": 0.25
    },
    {
      "id": "process_progress",
      "type": "rule-based",
      "scope": "step",
      "condition": "action.type == 'search_architect' and status == 'matching'",
      "reward": 0.2,
      "penalty": 0.0,
      "once": false,
      "rubric": "澄清后进入匹配阶段",
      "weight": 0.15
    },
    {
      "id": "task_success",
      "type": "rule-based",
      "scope": "terminal",
      "condition": "status == 'completed' and matched_architect is non-empty and user accepted referral",
      "reward": 1.0,
      "penalty": 0.0,
      "once": true,
      "rubric": "成功完成建筑师对接",
      "weight": 0.3
    },
    {
      "id": "task_failure",
      "type": "rule-based",
      "scope": "terminal",
      "condition": "status == 'failed' or clarification_rounds > 5 or no available architect matches clarified requirements",
      "reward": 0.0,
      "penalty": -0.8,
      "once": true,
      "rubric": "任务失败或澄清超限",
      "weight": 0.1
    },
    {
      "id": "trajectory_quality",
      "type": "model-based",
      "scope": "trajectory",
      "criteria": [
        "是否逐步确认所需建筑师类型、沟通目的和期望对接方式",
        "是否避免臆造建筑师信息",
        "是否基于可用资源提出可验证的对接建议"
      ],
      "score_range": [
        0,
        1
      ],
      "rubric": "澄清与对接轨迹质量",
      "weight": 0.05,
      "reward": 0.0,
      "penalty": 0.0,
      "once": false
    }
  ],
  "constraints": {
    "schema_version": "1.0",
    "authority": "env_factory_outer_workflow",
    "mutable_by_code_agent": false,
    "obligations": [
      {
        "id": "platform.persistence",
        "kind": "platform",
        "required": true
      },
      {
        "id": "platform.tool_schema",
        "kind": "platform",
